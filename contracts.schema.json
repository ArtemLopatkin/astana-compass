{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chinusoid/astana-compass/contracts.schema.json",
  "title": "Astana Compass contract seed v0.1.0",
  "description": "Canonical contracts only; this seed does not implement application services. Select a named $defs type.",
  "oneOf": [
    {
      "$ref": "#/$defs/RecommendationResponse"
    },
    {
      "$ref": "#/$defs/ItineraryResponse"
    },
    {
      "$ref": "#/$defs/RetrievalResponse"
    },
    {
      "$ref": "#/$defs/ErrorResponse"
    }
  ],
  "$defs": {
    "Location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "required": [
        "lat",
        "lon"
      ]
    },
    "Constraint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "array"
          ],
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "strength": {
          "enum": [
            "required",
            "preferred"
          ]
        }
      },
      "required": [
        "key",
        "value",
        "strength"
      ]
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        },
        "source_name": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "enum": [
            "osm",
            "official",
            "provider",
            "synthetic"
          ]
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "source_record_id": {
          "type": "string",
          "minLength": 1
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "is_synthetic": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "source_name",
        "source_type",
        "source_url",
        "source_record_id",
        "retrieved_at",
        "is_synthetic"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "is_synthetic": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "id": {
                "pattern": "^synthetic:"
              },
              "source_type": {
                "const": "synthetic"
              },
              "source_record_id": {
                "pattern": "^synthetic:"
              }
            }
          },
          "else": {
            "properties": {
              "source_type": {
                "not": {
                  "const": "synthetic"
                }
              }
            }
          }
        }
      ]
    },
    "PlaceFact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        },
        "status": {
          "enum": [
            "known",
            "unknown",
            "conflicting"
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": [
                "string",
                "number",
                "boolean",
                "array"
              ],
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
          },
          "uniqueItems": true
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "status",
        "value",
        "evidence_ids"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "known"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "array"
                ],
                "items": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                }
              },
              "evidence_ids": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              },
              "evidence_ids": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "conflicting"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              },
              "evidence_ids": {
                "minItems": 2
              }
            }
          }
        }
      ]
    },
    "Place": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "$ref": "#/$defs/Location"
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlaceFact"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1
        },
        "is_synthetic": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "location",
        "categories",
        "description",
        "facts",
        "evidence",
        "is_synthetic"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "is_synthetic": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "id": {
                "pattern": "^synthetic:"
              }
            }
          }
        }
      ]
    },
    "RecommendationRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "enum": [
            "ru",
            "kk",
            "en"
          ]
        },
        "origin": {
          "$ref": "#/$defs/Location"
        },
        "start_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "timezone": {
          "const": "Asia/Almaty"
        },
        "available_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "transport": {
          "enum": [
            "walking",
            "cycling",
            "driving"
          ]
        },
        "return_to_origin": {
          "type": "boolean"
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Constraint"
          }
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      },
      "required": [
        "query",
        "locale",
        "origin",
        "start_at",
        "timezone",
        "available_seconds",
        "transport",
        "return_to_origin",
        "constraints",
        "limit"
      ]
    },
    "ItineraryRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "enum": [
            "ru",
            "kk",
            "en"
          ]
        },
        "origin": {
          "$ref": "#/$defs/Location"
        },
        "start_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "timezone": {
          "const": "Asia/Almaty"
        },
        "available_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "transport": {
          "enum": [
            "walking",
            "cycling",
            "driving"
          ]
        },
        "return_to_origin": {
          "type": "boolean"
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Constraint"
          }
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "place_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
          },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        }
      },
      "required": [
        "query",
        "locale",
        "origin",
        "start_at",
        "timezone",
        "available_seconds",
        "transport",
        "return_to_origin",
        "constraints",
        "limit",
        "place_ids"
      ]
    },
    "RouteGeometry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "LineString"
        },
        "coordinates": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              }
            ]
          },
          "minItems": 2
        }
      },
      "required": [
        "type",
        "coordinates"
      ]
    },
    "RouteEstimate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "routed",
            "approximate"
          ]
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "transport": {
          "enum": [
            "walking",
            "cycling",
            "driving"
          ]
        },
        "distance_meters": {
          "type": "number",
          "minimum": 0
        },
        "duration_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "includes_return": {
          "type": "boolean"
        },
        "geometry": {
          "anyOf": [
            {
              "$ref": "#/$defs/RouteGeometry"
            },
            {
              "type": "null"
            }
          ]
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1
        },
        "generated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
        }
      },
      "required": [
        "method",
        "provider",
        "transport",
        "distance_meters",
        "duration_seconds",
        "includes_return",
        "geometry",
        "assumptions",
        "evidence",
        "generated_at"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "const": "routed"
              }
            }
          },
          "then": {
            "properties": {
              "geometry": {
                "$ref": "#/$defs/RouteGeometry"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "approximate"
              }
            }
          },
          "then": {
            "properties": {
              "geometry": {
                "type": "null"
              },
              "assumptions": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "ConstraintEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        },
        "strength": {
          "enum": [
            "required",
            "preferred"
          ]
        },
        "outcome": {
          "enum": [
            "satisfied",
            "unsatisfied",
            "unknown"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
          },
          "uniqueItems": true
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "key",
        "strength",
        "outcome",
        "evidence_ids",
        "explanation"
      ]
    },
    "Recommendation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "place_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        },
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "why": {
          "type": "string",
          "minLength": 1
        },
        "suggested_activity": {
          "type": "string",
          "minLength": 1
        },
        "activity_is_ai_suggestion": {
          "const": true
        },
        "visit_duration_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "visit_duration_is_estimate": {
          "const": true
        },
        "route": {
          "$ref": "#/$defs/RouteEstimate"
        },
        "total_duration_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "constraint_evaluations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConstraintEvaluation"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "place_id",
        "rank",
        "why",
        "suggested_activity",
        "activity_is_ai_suggestion",
        "visit_duration_seconds",
        "visit_duration_is_estimate",
        "route",
        "total_duration_seconds",
        "constraint_evaluations",
        "warnings"
      ]
    },
    "RecommendationResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        },
        "status": {
          "enum": [
            "matched",
            "partial",
            "no_match",
            "needs_clarification"
          ]
        },
        "request": {
          "$ref": "#/$defs/RecommendationRequest"
        },
        "places": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Place"
          }
        },
        "recommendations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Recommendation"
          },
          "maxItems": 3
        },
        "clarification_questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "generated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
        }
      },
      "required": [
        "request_id",
        "status",
        "request",
        "places",
        "recommendations",
        "clarification_questions",
        "warnings",
        "generated_at"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "no_match",
                  "needs_clarification"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "recommendations": {
                "maxItems": 0
              },
              "places": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "matched",
                  "partial"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "recommendations": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "needs_clarification"
              }
            }
          },
          "then": {
            "properties": {
              "clarification_questions": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "clarification_questions": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "partial",
                  "no_match"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "warnings": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "ItineraryStop": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "place_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        },
        "order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "visit_duration_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "visit_duration_is_estimate": {
          "const": true
        },
        "suggested_activity": {
          "type": "string",
          "minLength": 1
        },
        "activity_is_ai_suggestion": {
          "const": true
        },
        "constraint_evaluations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConstraintEvaluation"
          }
        }
      },
      "required": [
        "place_id",
        "order",
        "visit_duration_seconds",
        "visit_duration_is_estimate",
        "suggested_activity",
        "activity_is_ai_suggestion",
        "constraint_evaluations"
      ]
    },
    "ItineraryResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        },
        "status": {
          "enum": [
            "matched",
            "partial",
            "no_match",
            "needs_clarification"
          ]
        },
        "places": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Place"
          }
        },
        "clarification_questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "generated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "request": {
          "$ref": "#/$defs/ItineraryRequest"
        },
        "stops": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ItineraryStop"
          },
          "maxItems": 3
        },
        "route": {
          "anyOf": [
            {
              "$ref": "#/$defs/RouteEstimate"
            },
            {
              "type": "null"
            }
          ]
        },
        "total_duration_seconds": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "request_id",
        "status",
        "places",
        "clarification_questions",
        "warnings",
        "generated_at",
        "request",
        "stops",
        "route",
        "total_duration_seconds"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "no_match",
                  "needs_clarification"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "stops": {
                "maxItems": 0
              },
              "places": {
                "maxItems": 0
              },
              "route": {
                "type": "null"
              },
              "total_duration_seconds": {
                "const": 0
              }
            }
          },
          "else": {
            "properties": {
              "stops": {
                "minItems": 1
              },
              "route": {
                "$ref": "#/$defs/RouteEstimate"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "needs_clarification"
              }
            }
          },
          "then": {
            "properties": {
              "clarification_questions": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "clarification_questions": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "partial",
                  "no_match"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "warnings": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "RetrievalRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "enum": [
            "ru",
            "kk",
            "en"
          ]
        },
        "origin": {
          "$ref": "#/$defs/Location"
        },
        "radius_meters": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Constraint"
          }
        },
        "candidate_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "query",
        "locale",
        "origin",
        "radius_meters",
        "constraints",
        "candidate_limit"
      ]
    },
    "RetrievalHit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "place_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        },
        "score": {
          "type": "number"
        },
        "score_kind": {
          "enum": [
            "hybrid",
            "semantic",
            "lexical",
            "deterministic"
          ]
        },
        "matched_fact_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "place_id",
        "score",
        "score_kind",
        "matched_fact_keys"
      ]
    },
    "RetrievalResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "places": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Place"
          }
        },
        "hits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RetrievalHit"
          }
        },
        "strategy": {
          "type": "string",
          "minLength": 1
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "places",
        "hits",
        "strategy",
        "warnings"
      ]
    },
    "ErrorResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "enum": [
                "invalid_request",
                "unsupported_transport",
                "provider_unavailable",
                "rate_limited",
                "internal_error",
                "not_found"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "field": {
                    "type": "string",
                    "minLength": 1
                  },
                  "issue": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "field",
                  "issue"
                ]
              }
            }
          },
          "required": [
            "code",
            "message",
            "retryable",
            "details"
          ]
        }
      },
      "required": [
        "request_id",
        "error"
      ]
    },
    "HealthResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "ok",
            "unavailable"
          ]
        },
        "service": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "checked_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
        }
      },
      "required": [
        "status",
        "service",
        "version",
        "checked_at"
      ]
    },
    "PlaceListResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "places": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Place"
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "places",
        "next_cursor"
      ]
    },
    "FeedbackRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "rating": {
          "enum": [
            "helpful",
            "not_helpful"
          ]
        },
        "comment": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        }
      },
      "required": [
        "request_id",
        "rating",
        "comment"
      ]
    },
    "FeedbackResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "feedback_id": {
          "type": "string",
          "minLength": 1
        },
        "accepted": {
          "const": true
        }
      },
      "required": [
        "feedback_id",
        "accepted"
      ]
    },
    "DataSourceStatus": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_name": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "status": {
          "enum": [
            "ready",
            "stale",
            "unavailable",
            "not_configured"
          ]
        },
        "last_success_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "place_count": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "source_name",
        "source_url",
        "status",
        "last_success_at",
        "place_count",
        "warnings"
      ]
    },
    "DataStatusResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DataSourceStatus"
          }
        },
        "total_places": {
          "type": "integer",
          "minimum": 0
        },
        "checked_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
        }
      },
      "required": [
        "sources",
        "total_places",
        "checked_at"
      ]
    },
    "DegradedService": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "service": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "service",
        "reason",
        "retryable"
      ]
    },
    "ContextResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "places": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Place"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "degraded_services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DegradedService"
          }
        }
      },
      "required": [
        "places",
        "warnings",
        "degraded_services"
      ]
    }
  }
}
